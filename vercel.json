{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/platform", "destination": "/platform.html" },
    { "source": "/learn", "destination": "/index.html" },
    { "source": "/mockups", "destination": "/mockups.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
